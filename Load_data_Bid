def load_data_bid(file):
    data = []
    with open(file, "r", encoding="utf-8", errors="ignore") as fichier:
        lignes = fichier.readlines()
        for ligne in lignes[1:]: 
            ligne = ligne.strip()
            if ligne:
                player, prix_str = ligne.split(',')
                data.append((player, int(prix_str)))
    return data
    
def create_list_tuple (list):
    first = True
    J = ""
    B_str = ""
    B = 0
    J_finished = False
    new_list = []
    for i in list:
        for y in i:
            if J_finished == False and y != ",":
                J += y
            if J_finished == True and y != ",":
                B_str += y
            if y == ",":
                J_finished = True
        if first == False:
            B = int(B_str)
            new_list.append((J,B))
        else:
            first = False
            new_list.append((J,B_str))
        J = ""
        B = 0
        B_str = ""
        J_finished = False
            
    return new_list

def create_BST(liste):
    tree = []
    for player, prix in liste:
        tree = insert(tree, prix, player)
    return tree

def insert(tree, prix, player):
    if not tree:
        return [prix, [player], [], []]
    if prix == tree[0]:
        tree[1].append(player)
    elif prix < tree[0]:
        tree[2] = insert(tree[2], prix, player)
