"""the first function is a function that load a csv file with a specific structure (player name, price) and potentially the presence of sleeve then return with all the information in the file a list (data) of tuples and a Binary search tree"""
"""It use 3 function that are also used on other file."""

def Load_data_Bid(file):
    sleeve = False
    tree = []           #initialise the BST
    remaining = 0       #the way to count the number of object in one line
    data = []       #initialise the list of tuples
    new_object = ""         #the way to separate every object
    fichier = open(file, "r", encoding="utf-8", errors="ignore")    
    content = fichier.readlines()
    fichier.close()
    for i in content:       #this loop is used to remove the \n in every str contain in the file
        remaining = len(i) - 1
        for y in range(remaining):
            new_object += i[y]
        data.append(new_object)
        new_object = ""
    if data[0] == "manche,joueur,prix":
        sleeve = True
    if sleeve == False:
        data = create_list_tuple(data)      #changing data from a list of str to a list of tuples
        tree = create_BST(data)         #creating the tree from the list of tuples
        return data, tree
    else:
        data = create_list_sleeve_tuple(data)       #changing data from a list of str to a list of tuples with the sleeve taken in count
        tree = create_BST_sleeve(data)         #creating the tree from the list of tuples with sleeve taken in count
        return data, tree, True
  

"""This function take a list of str that is in the requiered format for the game and return a list of tuples that we will use for the study and the creation of the tree"""
def create_list_tuple (data):
    first = True            #look for the first 
    J = ""         #the player name
    B_str = ""         #str version of the bind
    B = 0         #int version of the bind
    J_finished = False         #verification for changement between name and bind
    new_list = []         #the returning list of tuples
    for i in data:         #loop of data that will separate the player name and the bind and make the bind be a intenger
        for y in i:
            if J_finished == False and y != ",":
                J += y
            if J_finished == True and y != ",":
                B_str += y
            if y == ",":
                J_finished = True
        if first == False:
            B = int(B_str)
            new_list.append((J,B))
        else:
            first = False
            new_list.append((J,B_str))
        J = ""
        B = 0
        B_str = ""
        J_finished = False       
    return new_list

"""This function take a list of str that is in the requiered format for the game with sleeves and return a list of tuples that we will use for the study and the creation of the tree"""
def create_list_sleeve_tuple(data):
    first = True            #look for the first 
    sleeve_str = ""         #str version of the sleeve
    sleeve = 0         #int version of the sleeve
    J = ""         #the player name
    B_str = ""         #str version of the bind
    B = 0         #int version of the bind
    J_finished = False         #verification for changement between name and bind
    Sleeve_finished = False         #verification for changement between sleeve and name
    new_list = []         #the returning list of tuples
    for i in data:         #loop of data that will separate the sleeve, the player name and the bind and make the bind and the sleeve be intengers
        for y in i:
            if Sleeve_finished == False and y != ",":
                sleeve_str += y
            if J_finished == False and Sleeve_finished == True and y != ",":
                J += y
            if J_finished == True and y != ",":
                B_str += y
            if y == ",":
                if Sleeve_finished == False:
                    Sleeve_finished = True
                else:
                    J_finished = True
        if first == False:
            B = int(B_str)
            sleeve = int(sleeve_str)
            new_list.append((sleeve,J,B))
        else:
            first = False
            new_list.append((sleeve_str,J,B_str))
        J = ""
        sleeve_str = ""
        sleeve = 0
        Sleeve_finished = False
        B = 0
        B_str = ""
        J_finished = False       
    return new_list


"""this is a function that create a BST from the list of tuples that we have created"""
def create_BST (liste):
    tree = []       #the returning tree
    x = 0       #the bind we want to add
    for i in liste:
        if type(i[1]) == int:
            x = i[1]
            tree = insert(tree, x)
    return tree


"""this is a function that create a BST from the list of tuples that we have created (this one take in count the sleeves)"""
def create_BST_sleeve(liste):
    tree = []       #the returning tree (it's a regroupment of multiple trees that correspond to each sleeve)
    node = []       #the list that is used to implement every tree
    sleeve = []     #the list of sleeves there are
    x = 0       #the bind we want to add
    for i in liste:
        if i[0] not in sleeve:
            tree.append([])
            sleeve.append(i[0])
    for i in sleeve:
        for y in liste:
            if y[0] == i and type(y[0]) == int:
                x = y[2]
                node = insert(node, x)
        if type(i) == int:
            tree[i - 1] = node
        else:
            tree.remove([])
        node = []
    return tree


"""this function insert one object in a BST tree"""
def insert (tree, x):
    if tree == []:
        tree.append(x)
        tree.append([])
        tree.append([])
        return tree
    if x < tree[0]:
        tree[1] = insert(tree[1], x)
    if x > tree[0]:
        tree[2] = insert(tree[2], x)
    return tree
