def Load_data_Bid(file):
    tree = []
    remaining = 0
    data = []
    new_object = ""
    fichier = open(file, "r", encoding="utf-8", errors="ignore")
    content = fichier.readlines()
    fichier.close()
    for i in content:
        remaining = len(i) - 1
        for y in range(remaining):
            new_object += i[y]
        data.append(new_object)
        new_object = ""
    data = create_list_tuple(data)
    tree = create_BTS(data)
    return data, tree
    
def create_list_tuple (list):
    first = True
    J = ""
    B_str = ""
    B = 0
    J_finished = False
    new_list = []
    for i in list:
        for y in i:
            if J_finished == False and y != ",":
                J += y
            if J_finished == True and y != ",":
                B_str += y
            if y == ",":
                J_finished = True
        if first == False:
            B = int(B_str)
            new_list.append((J,B))
        else:
            first = False
            new_list.append((J,B_str))
        J = ""
        B = 0
        B_str = ""
        J_finished = False
            
    return new_list

def create_BTS (liste):
    tree = []
    x = 0
    for i in liste:
        if type(i[1]) == int:
            x = i[1]
            tree = insert(tree, x)
    return tree

def insert (tree, x):
    if tree == []:
        tree.append(x)
        tree.append([])
        tree.append([])
        return tree
    if x < tree[0]:
        tree[1] = insert(tree[1], x)
    if x > tree[0]:
        tree[2] = insert(tree[2], x)
    return tree
