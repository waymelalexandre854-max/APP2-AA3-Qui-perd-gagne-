def get_sorted_nodes(tree):
    if not tree:
        return []
    left_part = get_sorted_nodes(tree[2])
    current_node = [(tree[0], tree[1])]  
    right_part = get_sorted_nodes(tree[3])
    return left_part + current_node + right_part

def calculate_costs(sorted_list, base_cost, alpha):
    total_revenue = 0
    player_costs = []  
    for price, players in sorted_list:
        one_bid_cost = base_cost + (alpha / (price + 1))
        for player in players:
            player_costs.append((player, one_bid_cost))
            total_revenue += one_bid_cost
            
    return player_costs, total_revenue
