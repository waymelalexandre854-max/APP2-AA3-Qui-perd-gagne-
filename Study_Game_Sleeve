"""this function will study a game given by a file that have sleeve and return the winning player or none"""
def study_game_sleeve (data, tree):
    dico_victory ={}        #the final dico that is used to see who is victorious
    sleeve = []     #list of sleeve there is
    possibility = []        #list of every possibilities of number and after is used for storing the number of player on a bind
    winner = []     #list of winning player for each sleeve
    sleeve_win = False      #block a sleeve when there is a winner
    x = 0
    for i in data:      #create the list of sleeve
        if i[0] not in sleeve and type(i[0]) == int:
            sleeve.append(i[0])
    for i in data:      #we first verify the number of possibilities that we have to verify
        if i[0] == 1 and i[1] not in possibility:
            possibility.append(i[1])
    x = len(possibility)
    for i in sleeve:        #this loop will first look at the lowest number possible then see if there is only one winner, if it's the case it will store that winner a lock all other winner for the actual sleeve, then repeat a new one until all sleeves are done
        for y in range(x):
            possibility = []
            lowest_numb = lowest_search(tree[i-1])
            for i in data:
                if i[2] == lowest_numb:
                    possibility.append(i)
            if len(possibility) == 1 and sleeve_win == False:
                winner.append(possibility[0][1])
                dico_victory[possibility[0][1]] = 0
                sleeve_win = True
            else:
                tree[i-1] = remove_tree(tree[i-1], lowest_numb)
        sleeve_win = False
    x = 0
    for i in winner:        #counting the number of victory
        dico_victory[i] += 1
    for key,value in dico_victory.items():      #looking at the greatest victory
        if x < value:
            x = value
    for key,value in dico_victory.items():      #returning the winner
        if value == x:
            return key
                 
"""a simple function that look for the lowest number in the tree"""
def lowest_search(tree):
    if tree[1] == []:
        return tree[0]
    else:
        return lowest_search(tree[1])


"""this first function will delete a value in the BST and us delete_max to modify all the tree in a way that doesn't destroy everything"""
def remove_tree(tree, x):
    if tree == []:
        return []
    if x < tree[0]:
        tree[1] = remove_tree(tree[1], x)
    elif x > tree[0]:
        tree[2] = remove_tree(tree[2], x)
    else: 
        if tree[1] == []: 
            return tree[2]
        elif tree[2] == []: 
            return tree[1]
        else: 
            val, tree[1] = delete_max(tree[1])
            tree[0] = val
    return tree

def delete_max(tree):
    if tree[2] == []:
        return tree[0], tree[1]
    val, tree[2] = delete_max(tree[2])
    return val, tree
