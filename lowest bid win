    def __init__(self):
        super().__init__()
        self.setWindowTitle("Choose Game Mode")

        layout = QVBoxLayout()

        btn1 = QPushButton("CSV Mode")
        btn1.clicked.connect(self.open_csv)
        layout.addWidget(btn1)

        btn2 = QPushButton("Player vs AI")
        btn2.clicked.connect(self.open_ai)
        layout.addWidget(btn2)

        self.setLayout(layout)

    def open_csv(self):
        self.csv = CSVWindow()
        self.csv.show()

    def open_ai(self):
        self.ai = Game()
        self.ai.show()


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = Menu()
    window.show()
    sys.exit(app.exec_())
