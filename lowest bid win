"""this AI play randomly between 0 and 70 for every turn it have"""
def Bozo(data):
    data.append(("Bozo", random.randint(1, 250)))
    return data


"""Those AI are cheating AI that will act by looking at the data list. They aren't fair"""
"""this AI always try tobe where someone isn't and so look between a range of 0 to 70 number to see where there is a place alone"""
def Cheater(data):
    liste = [i for i in range(71)]
    for i in data:
        if i[1] in liste:
            liste.remove(i[1])
    if liste != []:
        data.append(("Cheater", random.choice(liste)))
    else:
        data.append(("Cheater", random.randint(0,70)))
    return data
        
"""this AI don't play to win, it play to make everyone lose"""
def Joker(data):
    liste = []
    for i in data:
        if i[1] not in liste:
            liste.append(i[1])
    if liste == []:
        data.append(("Joker", random.randint(0,70)))
    else:
        data.append(("Joker", random.choice(liste)))
    return data

"""this AI try to separate every action it have by at least 10 and at most 20"""
def Separate(data, value):
    signe = random.randint(0,1)
    if signe == 0:
        value -= random.randint(10,20)
    else:
        value += random.randint(10,20)
    if value < 0:
        value += 21
    if value > 70:
        value -= 21
    data.append(("Separate", value))
    return value, data

"""this AI choose 5 possibilities and take the lowest one"""           
def Undicided(data):
    liste = []
    x = 100
    for i in range(5):
        liste.append(random.randint(1,70))
    for i in liste:
        if i < x:
            x = i
    data.append(("Undicided", x))
    return data


"""this AI basically delete all other action that have the same number as his number"""
def Staline(data):
    x = random.randint(0,70)
    for i in data:
        if i[1] == x:
            data.remove(i)
    data.append(("Stalin", x))
    return data

"""this AI will look at the cost and try to pay less than a dangerous amount for his action"""
def Greed(data, cost, a):
    verif = 0.0
    good = False
    while good == False:
        x = random.randint(0,70)
        verif = cost + (a/(x+1))
        if verif <= cost+(a/10):
            good = True
    data.append(("Greed",x))
    return data


"""this AI start low and increase his bind every turn"""
def Crescedo (data, value):
    if value == 0:
        value = random.randint(1,10)
    else: 
        value += random.randint(1,5)
    data.append(("Crescedo",value))
    return value, data


"""this function take a number of turn played, a list of all the AI that will play those turn and can also have a modified cost and alpha (set at 50 and 5 respectively at default)"""
def AI_data_create(nb_round, ai_list, cost=50, a=5):
    data = []  #the return data that will also be used for the tree
    svalue = 25    #this value is especially used for the Separate AI
    crvalue = 0     #this value is especially used for the crescedo AI

    for i in range(nb_round):
        for y in ai_list:
            if y == "Bozo":
                data = Bozo(data)
            elif y == "Cheater":
                data = Cheater(data)
            elif y == "Joker":
                data = Joker(data)
            elif y == "Separate":
                svalue, data = Separate(data, svalue)
            elif y == "Undicided":
                data = Undicided(data)
            elif y == "Staline":
                data = Staline(data)
            elif y == "Greed":
                data = Greed(data, cost, a)
            elif y == "Crescedo":
                crvalue, data = Crescedo(data, crvalue)

    return data


class Game(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Lowest Unique Bid Game")

        layout = QVBoxLayout()

        self.label = QLabel("Enter your bid (0–250):")
        layout.addWidget(self.label)

        self.input = QLineEdit()
        layout.addWidget(self.input)

        self.risk_label = QLabel("Risk factor (a):")
        layout.addWidget(self.risk_label)

        self.risk_input = QLineEdit()
        self.risk_input.setText("5")
        layout.addWidget(self.risk_input)

        self.risk_button = QPushButton("Update Risk Factor")
        self.risk_button.clicked.connect(self.update_risk)
        layout.addWidget(self.risk_button)

        self.btn = QPushButton("Play AI Round")
        self.btn.clicked.connect(self.play_round)
        layout.addWidget(self.btn)

        self.log = QTextEdit()
        self.log.setReadOnly(True)
        layout.addWidget(self.log)

        self.setLayout(layout)

        self.ai_list = [
            "Bozo", "Cheater", "Joker", "Separate",
            "Undicided", "Staline", "Greed", "Crescedo"
        ]

        self.round = 1
        self.a = 5

    def update_risk(self):
        self.a = float(self.risk_input.text())
        self.log.append(f"Risk factor updated to: {self.a}")

    def play_round(self):
        try:
            player_bid = int(self.input.text())

            self.log.append(f"\n Round {self.round} ")

            if player_bid == 0:
                self.log.append("Player bid: 0 (ELIMINATED THIS ROUND)")
                player_eliminated = True
            else:
                self.log.append(f"Player bid: {player_bid}")
                player_eliminated = False

            ai_bids = {}
            for ai in self.ai_list:
                data = AI_data_create(1, [ai], a=self.a)
                ai_bids[ai] = data[0][1]

            self.log.append(f"AI bids: {ai_bids}")

            all_bids = list(ai_bids.values())
            if not player_eliminated:
                all_bids.append(player_bid)

            bst = build_bst_ai(all_bids)

            full_data = []
            if not player_eliminated:
                full_data.append(("PLAYER", player_bid))

            for name, bid in ai_bids.items():
                full_data.append((name, bid))

            winner = study_game_ai(full_data, bst)

            winner_bid = None

            if winner == "PLAYER":
                winner_bid = player_bid
            elif winner is not None:
                winner_bid = ai_bids[winner]

            if player_eliminated:
                if winner == "PLAYER":
                    winner = None
                winner_bid = None

            if winner is None:
                self.log.append("No unique bid this round!")
            else:
                cost = 50
                risk = cost + (self.a / (player_bid + 1)) if player_bid != 0 else cost

                self.log.append(f"Winning unique bid: {winner_bid}")
                self.log.append(f"Winner: {winner}")
                self.log.append(f"Risk cost: {risk:.2f}")

            self.round += 1
            self.input.clear()

        except Exception as e:
            self.log.append("ERROR")
            self.log.append(str(e))


