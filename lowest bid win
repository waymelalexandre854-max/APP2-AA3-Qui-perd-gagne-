"""the first function is a function that load a csv file with a specific structure (player name, price) and potentially the presence of sleeve then return with all the information in the file a list (data) of tuples and a Binary search tree"""
"""It use 3 function that are also used on other file."""

def Load_data_Bid(file):
    sleeve = False
    tree = []           #initialise the BST
    remaining = 0       #the way to count the number of object in one line
    data = []       #initialise the list of tuples
    new_object = ""         #the way to separate every object
    fichier = open(file, "r", encoding="utf-8", errors="ignore")    
    content = fichier.readlines()
    fichier.close()
    for i in content:       #this loop is used to remove the \n in every str contain in the file
        remaining = len(i) - 1
        for y in range(remaining):
            new_object += i[y]
        data.append(new_object)
        new_object = ""
    if data[0] == "manche,joueur,prix":
        sleeve = True
    if sleeve == False:
        data = create_list_tuple(data)      #changing data from a list of str to a list of tuples
        tree = create_BST_csv(data)         #creating the tree from the list of tuples
        return data, tree
    else:
        data = create_list_sleeve_tuple(data)       #changing data from a list of str to a list of tuples with the sleeve taken in count
        tree = create_BST_sleeve(data)         #creating the tree from the list of tuples with sleeve taken in count
        return data, tree, True
  
"""This function take a list of str that is in the requiered format for the game and return a list of tuples that we will use for the study and the creation of the tree"""
def create_list_tuple (data):
    first = True            #look for the first 
    J = ""         #the player name
    B_str = ""         #str version of the bind
    B = 0         #int version of the bind
    J_finished = False         #verification for changement between name and bind
    new_list = []         #the returning list of tuples
    for i in data:         #loop of data that will separate the player name and the bind and make the bind be a intenger
        for y in i:
            if J_finished == False and y != ",":
                J += y
            if J_finished == True and y != ",":
                B_str += y
            if y == ",":
                J_finished = True
        if first == False:
            B = int(B_str)
            new_list.append((J,B))
        else:
            first = False
            new_list.append((J,B_str))
        J = ""
        B = 0
        B_str = ""
        J_finished = False       
    return new_list


"""This function take a list of str that is in the requiered format for the game with sleeves and return a list of tuples that we will use for the study and the creation of the tree"""
def create_list_sleeve_tuple(data):
    first = True            #look for the first 
    sleeve_str = ""         #str version of the sleeve
    sleeve = 0         #int version of the sleeve
    J = ""         #the player name
    B_str = ""         #str version of the bind
    B = 0         #int version of the bind
    J_finished = False         #verification for changement between name and bind
    Sleeve_finished = False         #verification for changement between sleeve and name
    new_list = []         #the returning list of tuples
    for i in data:         #loop of data that will separate the sleeve, the player name and the bind and make the bind and the sleeve be intengers
        for y in i:
            if Sleeve_finished == False and y != ",":
                sleeve_str += y
            if J_finished == False and Sleeve_finished == True and y != ",":
                J += y
            if J_finished == True and y != ",":
                B_str += y
            if y == ",":
                if Sleeve_finished == False:
                    Sleeve_finished = True
                else:
                    J_finished = True
        if first == False:
            B = int(B_str)
            sleeve = int(sleeve_str)
            new_list.append((sleeve,J,B))
        else:
            first = False
            new_list.append((sleeve_str,J,B_str))
        J = ""
        sleeve_str = ""
        sleeve = 0
        Sleeve_finished = False
        B = 0
        B_str = ""
        J_finished = False       
    return new_list



def insert_csv(tree, x):
    if not tree:
        return [x, [], []]
    if x < tree[0]:
        tree[1] = insert_csv(tree[1], x)
    elif x > tree[0]:
        tree[2] = insert_csv(tree[2], x)
    return tree

"""this is a function that create a BST from the list of tuples that we have created"""
def create_BST_csv(liste):
    tree = []       #the returning tree
    x = 0       #the bind we want to add
    for i in liste:
        if type(i[1]) == int:
            x = i[1]
            tree = insert_csv(tree, x)
    return tree



def create_BST_sleeve(liste):
    trees_dict = {}
    for item in liste:
        if isinstance(item[0], int):
            sleeve_id = item[0]
            price = item[2]
            if sleeve_id not in trees_dict:
                trees_dict[sleeve_id] = []
            trees_dict[sleeve_id] = insert_csv(trees_dict[sleeve_id], price)
    return trees_dict


def lowest_search_csv(tree):
    if not tree: return None
    if not tree[1]:
        return tree[0]
    return lowest_search_csv(tree[1])


def delete_max_csv(tree):
    if not tree[2]:
        return tree[0], tree[1]
    val, tree[2] = delete_max_csv(tree[2])
    return val, tree


"""this first function will delete a value in the BST and us delete_max to modify all the tree in a way that doesn't destroy everything"""
def remove_tree_csv(tree, x):
    if tree == []:
        return []
    if x < tree[0]:
        tree[1] = remove_tree_csv(tree[1], x)
    elif x > tree[0]:
        tree[2] = remove_tree_csv(tree[2], x)
    else: 
        if tree[1] == []: 
            return tree[2]
        elif tree[2] == []: 
            return tree[1]
        else: 
            val, tree[1] = delete_max_csv(tree[1])
            tree[0] = val
    return tree


"""this function will study a game given by a file that doesn't have any sleeve and return the winning player or none"""
def study_game_csv (data, tree):
    possibility = []        #list of every possibilities of number and after is used for storing the number of player on a bind
    for i in data:      #we first verify the number of possibilities that we have to verify
        if i[1] not in possibility:
            possibility.append(i[1])
    x = len(possibility)
    for i in range(x):      #this loop will first look at the lowest number possible then see if there is only one winner and show that winner, otherwise will continue. If no winner the programm give the result None
        possibility = []
        lowest_numb = lowest_search_csv(tree)
        for i in data:
            if i[1] == lowest_numb:
                possibility.append(i)
        if len(possibility) == 1:
            return possibility[0][0]
        else:
            tree = remove_tree_csv(tree, lowest_numb)
    return None

def study_game_sleeve(data, trees_dict):
    dico_victory = {}

    for sleeve_id in sorted(trees_dict.keys()):
        current_tree = trees_dict[sleeve_id]
        sleeve_winner = None

        while current_tree:
            lowest_numb = lowest_search_csv(current_tree)
            if lowest_numb is None: break

            bidders = [row for row in data if isinstance(row[0], int) and row[0] == sleeve_id and row[2] == lowest_numb]

            if len(bidders) == 1:
                sleeve_winner = bidders[0][1]
                break
            else:
                current_tree = remove_tree_csv(current_tree, lowest_numb)

        if sleeve_winner:
            dico_victory[sleeve_winner] = dico_victory.get(sleeve_winner, 0) + 1

    overall_winner = None
    max_wins = 0
    for player, wins in dico_victory.items():
        if wins > max_wins:
            max_wins = wins
            overall_winner = player

    return overall_winner


class CSVWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Lowest Bid Game (CSV)")
        self.setGeometry(200, 200, 400, 200)

        layout = QVBoxLayout()

        self.label = QLabel("Load a CSV file to find the winner")
        layout.addWidget(self.label)

        self.button = QPushButton("Load CSV File")
        self.button.clicked.connect(self.load_file)
        layout.addWidget(self.button)

        self.result_label = QLabel("Winner: ")
        layout.addWidget(self.result_label)

        self.setLayout(layout)

    def load_file(self):
        result = QFileDialog.getOpenFileName(self, "Open CSV File", "", "CSV Files (*.csv)")
        file_path = result[0]

        if file_path:
            try:
                result = Load_data_Bid(file_path)

                if len(result) == 2:
                    data, tree = result
                    winner = study_game_csv(data, tree)
                else:
                    data, tree, _ = result
                    winner = study_game_sleeve(data, tree)

                if winner:
                    self.result_label.setText(f"Winner: {winner}")
                else:
                    self.result_label.setText("No unique winner")

            except Exception as e:
                self.result_label.setText(f"Error: {str(e)}")



def insert_ai (tree, x):
    if tree == []:
        tree.append(x)
        tree.append([])
        tree.append([])
        return tree
    if x < tree[0]:
        tree[1] = insert_ai(tree[1], x)
    if x > tree[0]:
        tree[2] = insert_ai(tree[2], x)
    return tree



def build_bst_ai(values):
    tree = []
    for v in values:
        tree = insert_ai(tree, v)
    return tree


def lowest_search_ai(tree):
    if tree[1] == []:
        return tree[0]
    return lowest_search_ai(tree[1])


def delete_max_ai(tree):
    if tree[2] == []:
        return tree[0], tree[1]

    val, tree[2] = delete_max_ai(tree[2])
    return val, tree


def remove_tree_ai(tree, x):
    if tree == []:
        return []

    if x < tree[0]:
        tree[1] = remove_tree_ai(tree[1], x)

    elif x > tree[0]:
        tree[2] = remove_tree_ai(tree[2], x)

    else:
        if tree[1] == []:
            return tree[2]
        elif tree[2] == []:
            return tree[1]
        else:
            val, tree[1] = delete_max_ai(tree[1])
            tree[0] = val

    return tree


